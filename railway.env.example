# Copy these variables into Railway → Service → Variables
# Do NOT commit real secrets.

# --- Required ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional extra owner chats (comma-separated), only used when multi-tenancy
# is off -- lets the owner reach the bot from more than one chat. Anyone
# else is ignored. Multi-tenant deployments use the tenant registry instead.
# TELEGRAM_ALLOWED_CHAT_IDS=
# Required in production -- signal and coin webhooks fail closed without a token.
SIGNAL_WEBHOOK_TOKEN=
COIN_WEBHOOK_TOKEN=

# MongoDB — Option A: Railway Mongo (empfohlen, gleiches Projekt)
# Im Bot-Service Variable referenzieren: ${{Mongo.MONGO_URL}}
# (Service-Name kann abweichen — im Railway-Dashboard unter Mongo → Variables nachsehen)
# MONGO_URL wird automatisch vom Mongo-Service gesetzt

# Option B: explizit setzen (Atlas oder Railway Public URL)
# MONGODB_URI=mongodb://...

MONGODB_DB=xagent_test

# WICHTIG — Lokale Entwicklung vs. Railway:
# - Auf dem Mac NIEMALS MONGO_URL aus Railway in die Shell exportieren.
# - Lokale Tests/Bot: source scripts/dev_local_mongo.sh (localhost:27017)
# - Railway-Bot nutzt MONGO_URL vom Mongo-Service (nur auf Railway gesetzt)
# - pytest nutzt xagent_pytest (nicht xagent_test) — drop_database(test=True) ist isoliert
# - Remote-Wipes und Drops auf xagent_test sind blockiert

# Set by Railway automatically when you enable a public domain:
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# Or set explicitly:
WEBHOOK_BASE_URL=https://your-app.up.railway.app

# --- Bot identity (visible in Telegram via /mode and message prefix) ---
# BOT_TIMEZONE=Europe/Berlin
# TZ=Europe/Berlin

# BOT_STACK=production   # or staging | local  (test is deprecated alias for staging)
# Deploy staging: bash scripts/deploy_staging.sh  (git push branch staging → Railway)
# /mode priority: RAILWAY_GIT_COMMIT_SHA (Railway GitHub deploy) → GIT_COMMIT → build_meta.json
# Do not set static GIT_COMMIT/GIT_BRANCH on staging — they stale-block /mode after git pushes.
# TELEGRAM_STARTUP_NOTIFY=1   # one short message on Railway boot (default on)

# --- Demo mode (matches local start_demo_with_ngrok.sh) ---
# Set by scripts/railway_start.sh automatically:
# DEMO_MODE=1
# DEMO_LEDGER_BACKEND=mongo
# RAILWAY_DEPLOY=1

# --- WQE (Watchlist Quality Engine) ---
# WATCHLIST_QUALITY_MODE=shadow   # off | shadow | soft | enforce
# WATCHLIST_QUALITY_EVENT_LOG=1   # logs/wqe_events.jsonl
# Staging: volume xagent-test-volume mounted at /app/logs (scores + wqe_events survive redeploy)
# RAILWAY_VOLUME_MOUNT_PATH is set by Railway when the volume is attached

# --- Optional API keys (same as local .env) ---
GATE_API_KEY=
GATE_SECRET=
OPENAI_API_KEY=
CMC_API_KEY=
X_BEARER_TOKEN=
XAI_API_KEY=
# CRYPTOCOMPARE_API_KEY=         # unset = no CryptoCompare news call (poller: skipped_no_key)

# --- SuperGrok / xAI subscription (bot service; default OFF) ---
# Unset / 0 / false = today's path: https://api.x.ai/v1 + XAI_API_KEY. That is the rollback.
# 1 / true / yes / on + URL + token = Grok / WQE critic / x_search via the sidecar /v1 proxy.
# Sidecar 401/403/503 or connection error → one retry on XAI_API_KEY; timeouts do not fall back.
# XAI_USE_SUBSCRIPTION=
# XAI_AUTH_SIDECAR_URL=http://xagent-xai-auth.railway.internal:8080
#   Railway injects PORT (currently 8080, not the local Dockerfile default 8787). Include it.
# XAI_AUTH_TRIGGER_TOKEN=        # same value as on the xagent-xai-auth sidecar

# --- xagent-xai-auth sidecar (comment only — set on that service, not the bot) ---
# Service name: xagent-xai-auth
# Image: dedicated Node Dockerfile services/xai_auth_sidecar/Dockerfile
#   (services/xai_auth_sidecar/railway.toml dockerfilePath; shared root Dockerfile stays Node-free)
# Volume mount: /data/grok
# XAI_OAUTH_CREDENTIAL_PATH=     # default $RAILWAY_VOLUME_MOUNT_PATH/xai_oauth.json
# Do not put OAuth access/refresh tokens in env. Login: Telegram /xai_login or railway ssh.

# --- Redis (Railway plugin — CLI: railway add --database redis) ---
# Im Bot-Service referenzieren: REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_URL wird von bus/redis_client.resolve_redis_url() bevorzugt (überschreibt localhost aus config.json)

# --- Webhooks (PR-P1/P4) ---
# SIGNAL_WEBHOOK_TOKEN=          # optional, TradingView ?token=
# COIN_WEBHOOK_TOKEN=            # optional, /api/coins/prices

# --- Optional tuning ---
# WEBHOOK_DROP_PENDING=1
# HOST=0.0.0.0
# PORT=5000