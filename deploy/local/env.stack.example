# Copy to deploy/local/env.stack (gitignored) or export before local_stack_*.sh
# Mirrors Railway staging service layout on the Mac.
#
#   cp deploy/local/env.stack.example deploy/local/env.stack
#
# HARD RULE: never put Railway MONGO_URL here for everyday bot runs.

# --- Identity ---
BOT_STACK=local
DEMO_MODE=1
DEMO_LEDGER_BACKEND=mongo
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=xagent_test
MONGODB_TEST_DB=xagent_pytest
# MONGO_URL must stay unset (dev_local_mongo.sh clears it)

REDIS_URL=redis://127.0.0.1:6379/0

# --- Weaviate (xagent-weaviate) ---
WEAVIATE_URL=http://127.0.0.1:8080
WEAVIATE_HOST_PORT=8080
WEAVIATE_GRPC_PORT=50051

# --- Health ports (avoid collisions; Railway uses PORT=8080 per service) ---
BOT_PORT=5000
HERMES_PORT=8090
SANTIMENT_PORT=8091
MARKET_ORACLE_PORT=8092
MEMORY_CORTEX_PORT=8765

# --- Hermes (xagent-hermes) ---
HERMES_RUN_LEARNING=0
HERMES_INTERVAL_SEC=1800
# HERMES_LIVE_EVIDENCE_MODE=observe

# --- Sidecars (optional Tier C) ---
# BOT_INGEST_URL=http://127.0.0.1:5000/...
# SANTIMENT_API_KEY=
# DRY_RUN=1

# --- Memory cortex (xagent-memory-cortex) ---
MEMORY_VIZ_DEMO=0

# --- Compose ---
# LOCAL_STACK_FULL=1   # also start mongo+redis containers (profile full)
