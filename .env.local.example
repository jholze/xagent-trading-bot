# Local dev overrides — copy to .env.local (gitignored).
# Use a SEPARATE Telegram bot from Railway production so webhooks do not conflict.
#
# Setup:
#   1. Create bot via @BotFather → paste token below
#   2. Send /start to the bot in Telegram
#   3. bash scripts/get_telegram_chat_id.sh
#   4. bash scripts/start_demo_with_ngrok.sh
#
# NEVER put Railway production TELEGRAM_BOT_TOKEN here if you still run Railway —
# each bot token gets its own webhook (ngrok local vs Railway URL).

TELEGRAM_BOT_TOKEN=123456789:AA...your-dev-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional: force demo mongo (start_demo_with_ngrok.sh sets these anyway)
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=xagent_test